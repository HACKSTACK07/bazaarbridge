{
  "name": "bazaarbridge",
  "version": "7.2.0",
  "description": "BazaarBridge - Digital marketplace connecting local retailers with online customers",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
