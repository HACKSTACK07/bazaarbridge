{
  "name": "bazaarbridge-backend",
  "version": "7.2.0",
  "description": "BazaarBridge Backend - Node.js/Express API with PostgreSQL, Kafka, OpenSearch",
  "private": true,
  "main": "src/api/index.js",
  "scripts": {
    "start": "node src/api/index.js",
    "dev": "node --watch src/api/index.js",
    "seed": "node ../src/seed/seed.js",
    "seed:verify": "node ../src/seed/verify.js",
    "test": "node ../scripts/run-tests.js",
    "test:unit": "node --test src/tests/*.test.js",
    "secrets:check": "bash ../scripts/check-secrets.sh"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "kafkajs": "^2.2.4",
    "@opensearch-project/opensearch": "^2.11.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^10.0.0",
    "dotenv": "^16.4.5",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.4.0"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=20.0.0"
  }
}